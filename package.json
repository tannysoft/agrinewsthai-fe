{
  "name": "agrinewsthai",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @agrinewsthai/web dev",
    "dev:cms": "pnpm --filter @agrinewsthai/cms dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "deploy:cms": "pnpm --filter @agrinewsthai/cms deploy",
    "deploy:web": "pnpm --filter @agrinewsthai/web deploy",
    "migrate:wp": "pnpm --filter @agrinewsthai/cms migrate:wp"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
