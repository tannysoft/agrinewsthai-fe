# "payload" reads the new CMS (apps/cms); "wordpress" reads the old site's REST API.
CMS_SOURCE=payload
CMS_URL=http://localhost:3001
# Public R2 domain for media (leave empty locally; the CMS serves files)
MEDIA_URL=
# Shared with apps/cms
REVALIDATE_SECRET=
# Draft preview: same PREVIEW_SECRET as the CMS, plus the API key of a CMS user
# (Users → enable API key) used to read drafts
PREVIEW_SECRET=
CMS_PREVIEW_API_KEY=
