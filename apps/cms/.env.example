# Payload secret: openssl rand -hex 32
PAYLOAD_SECRET=
# Shared with apps/web — lets the CMS tell the website to refresh its cache
REVALIDATE_SECRET=
CMS_URL=http://localhost:3001
WEB_URL=http://localhost:3000
# Leave empty locally (files are served through /api/media/file)
MEDIA_URL=
# Shared with apps/web: the "Preview" button opens drafts on the website
PREVIEW_SECRET=
